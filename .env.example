# ==============================================================================
# AI Quota Dashboard Configuration
# ==============================================================================

# Server settings
PORT=3456
HOST=0.0.0.0

# Persistent Data Directory (holds quota.db and accounts.json)
# In Docker, this is mounted to /data
DATA_DIR=./data

# Public URL used for OAuth callbacks (e.g. http://localhost:3456 or https://quota.mydomain.com)
PUBLIC_URL=http://localhost:3456

# Authentication Mode
# Options: 'none' | 'token' | 'password' | 'ip_whitelist' | 'reverse_proxy'
AUTH_MODE=none

# If AUTH_MODE=token
AUTH_TOKEN=your-secret-token-here

# If AUTH_MODE=password
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-a-secure-password

# If AUTH_MODE=ip_whitelist (comma-separated list of IPs or CIDRs)
ALLOWED_IPS=127.0.0.1,192.168.1.0/24

# If AUTH_MODE=reverse_proxy (header name containing authenticated user)
PROXY_USER_HEADER=x-forwarded-user

# Polling & Real-time configuration
POLL_INTERVAL_SECONDS=120
ENABLE_WEBSOCKET=true
DATA_RETENTION_DAYS=30

# Optional Google OAuth Credentials Override (defaults to bundled Antigravity client credentials)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
